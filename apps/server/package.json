{
  "name": "server",
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./trpc/routers/_app": "./src/trpc/routers/_app.ts"
  },
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc -b",
    "compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "dev": "bun run --hot src/index.ts",
    "start": "node dist/index.mjs",
    "test": "bun test ./src --max-concurrency=1"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.61",
    "@hono/node-server": "^2.0.12",
    "@hono/trpc-server": "^0.4.2",
    "@sycom/auth": "workspace:*",
    "@sycom/certificates": "workspace:*",
    "@sycom/db": "workspace:*",
    "@sycom/emails": "workspace:*",
    "@sycom/env": "workspace:*",
    "@sycom/logger": "workspace:*",
    "@sycom/storage": "workspace:*",
    "@sycom/ui": "workspace:*",
    "@trpc/server": "catalog:",
    "ai": "^6.0.175",
    "better-auth": "catalog:",
    "dotenv": "catalog:",
    "drizzle-orm": "catalog:",
    "hono": "catalog:",
    "reading-time": "^1.5.0",
    "superjson": "^2.2.6",
    "trpc-ui-zod4": "^1.1.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@sycom/config": "workspace:*",
    "@types/bun": "catalog:",
    "@types/pg": "^8.20.0",
    "pg": "^8.20.0",
    "tsdown": "^0.21.10",
    "typescript": "^6.0.3"
  }
}
